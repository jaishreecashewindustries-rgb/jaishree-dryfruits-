rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ── USERS ────────────────────────────────────────────────────────────────
    // FIX: Users can update their own doc but CANNOT set the 'role' field.
    // Set role: "admin" only via Firebase Console (bypasses these rules).
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // New accounts default to role:"customer" client-side (see
      // AuthContext.createUserDoc) — allow that, but block self-elevation
      // to "admin" or anything else at creation time.
      allow create: if isOwner(userId)
        && request.resource.data.get('role', 'customer') == 'customer';

      allow update: if (
        isOwner(userId)
        && request.resource.data.get('role', '') == resource.data.get('role', '')
      ) || isAdmin();

      allow delete: if isAdmin();
    }

    // ── PRODUCTS ─────────────────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── ORDERS ───────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow create: if true;
      // Split get/list: knowing the exact order ID (an unguessable random
      // code, same trust model as a "view your order" magic link) is enough
      // to fetch that ONE order — this is what lets guest checkouts (no
      // userId to match) use Track Order without logging in. `list` stays
      // locked to the owner/admin so the collection can't be enumerated.
      allow get: if true;
      allow list: if isOwner(resource.data.userId) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // ── REVIEWS ──────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if resource.data.get('status', '') == 'approved' || isAdmin();
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // ── EMAIL OTPS ───────────────────────────────────────────────────────────
    // Written/read only by Cloud Functions (admin SDK, bypasses rules) —
    // codes and password-reset capability must never be client-readable.
    match /email_otps/{email} {
      allow read, write: if false;
    }

    // ── COINS ────────────────────────────────────────────────────────────────
    match /coins/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /coin_transactions/{txId} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // ── COUPONS ──────────────────────────────────────────────────────────────
    match /coupons/{couponId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ── BLOG ─────────────────────────────────────────────────────────────────
    match /blog/{postId} {
      allow read: if resource.data.get('published', false) == true || isAdmin();
      allow write: if isAdmin();
    }

    // ── INQUIRIES / CONTACT ───────────────────────────────────────────────────
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── RETURN REQUESTS ──────────────────────────────────────────────────────
    match /return_requests/{reqId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ── NEWSLETTER / LEADS ───────────────────────────────────────────────────
    match /newsletter/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── SITE SETTINGS ────────────────────────────────────────────────────────
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── STOCK NOTIFICATIONS (Notify Me) ─────────────────────────────────────
    match /stock_notifications/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── MAIL (Firebase "Trigger Email" extension contract) ──────────────────
    // Documents written here are picked up by the Trigger Email extension
    // (if installed) to send transactional emails. Client only ever creates.
    match /mail/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
