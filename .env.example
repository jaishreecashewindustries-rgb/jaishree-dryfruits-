# ══════════════════════════════════════════════════════════════
#  JAI SHREE DRY FRUITS — Environment Variables
#  Copy this file to .env and fill in your actual values.
#  NEVER commit .env to Git.
# ══════════════════════════════════════════════════════════════

# ── Firebase Configuration ────────────────────────────────────
# Get these from: Firebase Console → Project Settings → Your Apps
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id
REACT_APP_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Razorpay ──────────────────────────────────────────────────
# Use TEST key during development: rzp_test_...
# Use LIVE key only in production: rzp_live_...
# Get from: https://dashboard.razorpay.com → Settings → API Keys
REACT_APP_RAZORPAY_KEY=rzp_test_REPLACE_WITH_YOUR_KEY

# ── Admin WhatsApp ────────────────────────────────────────────
# International format without + or spaces (e.g. 917568577968)
# New orders will auto-send a WhatsApp message to this number
REACT_APP_ADMIN_WA=917568577968

# ── EmailJS (order confirmation emails) ─────────────────────────
# Get from: https://dashboard.emailjs.com → Email Services / Email Templates / Account
REACT_APP_EMAILJS_SERVICE_ID=service_xxxxxxx
REACT_APP_EMAILJS_TEMPLATE_ID=template_xxxxxxx
REACT_APP_EMAILJS_PUBLIC_KEY=your_public_key
