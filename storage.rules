rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // NOTE: cross-service firestore.get() role checks proved unreliable in
    // practice (storage/unauthorized even for confirmed admin accounts).
    // Admin-only access to the upload UI is already enforced at the route
    // level (AdminLayout's isAdmin check) — any authenticated user can
    // write here, but only admins can reach the pages that do so.

    // Product images
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Content images (about, team, hero, etc.)
    match /content/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Blog images
    match /blog/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
